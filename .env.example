# AdsIQ MCP server environment
# Base URL of the AdsIQ API (default: https://ads-iq.vercel.app)
ADSIQ_API_URL=https://ads-iq.vercel.app

# Supabase project used for authentication (REQUIRED)
ADSIQ_SUPABASE_URL=
ADSIQ_SUPABASE_ANON_KEY=

# Optional: auto sign-in on start
ADSIQ_EMAIL=
ADSIQ_PASSWORD=
